# AWS Credentials
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=us-east-1

# Amazon Bedrock Model IDs (Nova 2 generation)
NOVA_LITE_MODEL_ID=us.amazon.nova-2-lite-v1:0
NOVA_SONIC_MODEL_ID=us.amazon.nova-2-sonic-v1:0

# Nova cost controls
SHOWRUNNER_MAX_RETRIES=1
SHOWRUNNER_MAX_TOKENS=500
SHOWRUNNER_TEMPERATURE=0.4
NOVA_MAX_SCENES_PER_EPISODE=2

# Pexels API
PEXELS_API_KEY=your_pexels_api_key

# NewsAPI
NEWSAPI_KEY=your_newsapi_key

# S3 / CloudFront
S3_BUCKET=
CLOUDFRONT_DOMAIN=

# Supabase Storage (optional, preferred over S3 when set)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
SUPABASE_PATH_PREFIX=episodes

# Server
HOST=0.0.0.0
PORT=8000
